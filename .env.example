# Gemma: "ollama" runs it on this computer, "google" uses Google AI Studio (for the hosted demo)
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma3:4b
GOOGLE_API_KEY=
GOOGLE_MODEL=gemma-4-26b-a4b-it

# MongoDB Atlas connection string (Connect > Drivers in the Atlas UI)
MONGODB_URI=
MONGODB_DB=legacyloom

# Transcription: auto uses local Whisper when installed, otherwise ElevenLabs Scribe
TRANSCRIBER=auto
WHISPER_MODEL=small
# Force a language for Whisper if detection struggles, e.g. yo, ha, en
WHISPER_LANGUAGE=

# ElevenLabs (voice replies and Scribe transcription)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# TabPFN by Prior Labs (free token at ux.priorlabs.ai)
TABPFN_TOKEN=

# Set this before sharing the app publicly. Without it, anyone can add or delete.
APP_PASSCODE=
PUBLIC_BASE_URL=http://127.0.0.1:8000
