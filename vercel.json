{
  "builds": [
    { "src": "index.py", "use": "@vercel/python", "config": { "maxDuration": 300 } },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/public/static/$1" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/app/?", "dest": "/public/app.html" },
    { "src": "/docs/?", "dest": "/public/docs.html" },
    { "src": "/faq/?", "dest": "/public/faq.html" },
    { "src": "/support/?", "dest": "/public/support.html" },
    { "src": "/api/planner", "dest": "https://legacy-loom-planner.vercel.app/api/planner" },
    { "src": "/(.*)", "dest": "/index.py" }
  ]
}
